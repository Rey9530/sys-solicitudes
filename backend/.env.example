# =============================================================================
# Backend · Variables de entorno (ejemplo)
# =============================================================================
# Documentadas en /.env.example (raíz) que es la fuente única.
# Este archivo existe por compatibilidad con la convención de NestJS.

NODE_ENV=development
PORT=4000
LOG_LEVEL=info
APP_BASE_URL=http://localhost:4000
CORS_ORIGINS=http://localhost:3000
DATABASE_URL=postgresql://syssol:syssol@localhost:5432/syssol?schema=public
DATABASE_DIRECT_URL=postgresql://syssol:syssol@localhost:5432/syssol?schema=public
JWT_SECRET=dev-secret-change-me-in-production-min-64-chars-base64-aaaaaaaaaaaaaaaa
JWT_ACCESS_TTL=3600s
JWT_REFRESH_TTL=14d
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_USE_SSL=false
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
JSREPORT_URL=http://localhost:5488
# Correo (Mailgun API HTTP). Sin MAILGUN_API_KEY → modo log-only (no envía).
# MAILGUN_API_URL: US https://api.mailgun.net | EU https://api.eu.mailgun.net
MAILGUN_API_KEY=
MAILGUN_DOMAIN=
MAILGUN_FROM="Plazapp <noreply@plazapp.com>"
MAILGUN_API_URL=https://api.mailgun.net
TZ=America/El_Salvador
