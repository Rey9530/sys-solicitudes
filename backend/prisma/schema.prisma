// Prisma 7 schema · Plazapp
// Detalles: PLANIFICACION/01-setup-base.md (T-010) y docs/04-modelo-de-datos.md.
//
// Este schema es el BASE. Los modelos de cada módulo se agregan en las
// tareas correspondientes: ver PLANIFICACION/02 (auth), 03 (plazas), 04
// (locales), 05 (categorías), 06 (solicitudes), etc.
//
// Convenciones:
//  - Todos los IDs son UUID v4 (S-MD-A).
//  - Las tablas de negocio tienen `plaza_id NOT NULL` + FK a `plaza.id`.
//  - Los timestamps son `TIMESTAMPTZ` (UTC en BD, conversión en display).
//  - Soft delete con `deleted_at` (S-MD-B) en entidades de negocio.

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["driverAdapters", "fullTextSearchPostgres"]
}

// Prisma 7: la URL de conexión se configura en prisma.config.ts
// (no se admite `url` / `directUrl` en datasource).
datasource db {
  provider = "postgresql"
}

// ─────────────────────────────────────────────────────────────────────────────
// Catálogo global (sin plaza_id)
// ─────────────────────────────────────────────────────────────────────────────

/// Roles globales del sistema. Catálogo fijo no editable.
/// Códigos: superadmin | admin_plaza | inquilino.
/// Detalles: docs/04-modelo-de-datos.md §1.1, PLANIFICACION/02 T-017.
model rol {
  id          String   @id @default(uuid()) @db.Uuid
  codigo      String   @unique
  nombre      String
  descripcion String?
  created_at  DateTime @default(now()) @db.Timestamptz(6)

  usuarios usuario[]

  @@map("rol")
}

// ─────────────────────────────────────────────────────────────────────────────
// Tenant raíz
// ─────────────────────────────────────────────────────────────────────────────

/// Plaza comercial (tenant). Decisiones aplicadas:
///   T-V01: slug NO aparece en URL (es identificador interno, inmutable).
///   T-V08: timezone FIJA en `America/El_Salvador` (campo no editable).
///   T-V08: tanto superadmin como admin_plaza pueden editar branding.
/// Detalles: docs/04-modelo-de-datos.md §1.1, PLANIFICACION/03 T-036.
model plaza {
  id                 String   @id @default(uuid()) @db.Uuid
  slug               String   @unique
  nombre_comercial   String
  email_contacto     String?
  telefono_contacto  String?
  logo_url           String?
  color_primario     String   @default("#2563eb")
  // T-V08: timezone fija, no editable desde la app
  timezone           String   @default("America/El_Salvador")
  created_at         DateTime @default(now()) @db.Timestamptz(6)
  updated_at         DateTime @updatedAt @db.Timestamptz(6)
  deleted_at         DateTime? @db.Timestamptz(6)

  // Relaciones (se completan en las tareas de cada módulo)
  configuracion   configuracion?
  usuarios        usuario[]
  roles_staff     rol_staff[]
  auditoria_login auditoria_login[]
  locales         local[]
  inquilinos      inquilino[]
  contratos       contrato[]
  adjuntos        adjunto[]
  email_logs      email_log[]
  categorias      categoria[]
  subcategorias   subcategoria[]
  solicitudes     solicitud[]
  solicitud_historial solicitud_historial[]
  comentarios     comentario[]

  @@index([deleted_at])
  @@map("plaza")
}

/// Configuración 1:1 con plaza. Detalles: PLANIFICACION/03 T-037 y T-044.
model configuracion {
  id                                   String   @id @default(uuid()) @db.Uuid
  plaza_id                             String   @unique @db.Uuid
  // T-V06: 50 MB por defecto (en lugar de 25 MB del plan original)
  tamanio_max_archivo_mb               Int      @default(50)
  mime_types_permitidos                Json     @default("[\"application/pdf\",\"image/jpeg\",\"image/png\",\"image/webp\",\"application/vnd.ms-excel\",\"application/vnd.openxmlformats-officedocument.spreadsheetml.sheet\",\"application/vnd.openxmlformats-officedocument.wordprocessingml.document\",\"application/dwg\"]")
  sla_dias_por_tipo                    Json     @default("{\"mantenimiento\":5,\"evento\":3,\"remodelacion\":15,\"otro\":7}")
  sla_multiplicador_por_prioridad      Json     @default("{\"A\":0.5,\"B\":1.0,\"C\":1.5,\"D\":2.0,\"F\":3.0}")
  calendar_mostrar_hitos_contrato      Boolean  @default(true)
  // T-V05: umbral de aprobación especial para eventos
  aprobacion_especial_asistentes_min   Int      @default(200)
  updated_at                           DateTime @updatedAt @db.Timestamptz(6)

  plaza plaza @relation(fields: [plaza_id], references: [id], onDelete: Cascade)

  @@map("configuracion")
}

// ─────────────────────────────────────────────────────────────────────────────
// Usuarios y staff (módulo 02 · autenticación)
// ─────────────────────────────────────────────────────────────────────────────

/// Usuario del sistema. v1: pertenece a UNA sola plaza y UN solo rol (S-MT-C).
/// Decisiones aplicadas:
///   - rol_id como FK directa (no pivote). Sesión 2026-06-05.
///   - plaza_id NULL solo para superadmin; NOT NULL para admin_plaza/inquilino (app).
///   - rol_staff_id NOT NULL cuando rol=admin_plaza (validado en app, S-ResponsabilidadStaff).
///   - inquilino_id: FK real a inquilino (añadida en módulo 04, T-048).
///   - password_hash bcrypt cost 12, prefijo $2b$/$2a$ (RI-5, validado en app).
/// Detalles: docs/04-modelo-de-datos.md §1.1, PLANIFICACION/02 T-018.
model usuario {
  id             String    @id @default(uuid()) @db.Uuid
  plaza_id       String?   @db.Uuid
  inquilino_id   String?   @db.Uuid // FK lógica a inquilino (módulo 04)
  rol_id         String    @db.Uuid
  rol_staff_id   String?   @db.Uuid
  email          String
  password_hash  String
  nombre         String
  telefono       String?
  email_invalido Boolean   @default(false)
  last_login_at  DateTime? @db.Timestamptz(6)
  created_at     DateTime  @default(now()) @db.Timestamptz(6)
  updated_at     DateTime  @updatedAt @db.Timestamptz(6)
  deleted_at     DateTime? @db.Timestamptz(6)

  plaza                 plaza?                @relation(fields: [plaza_id], references: [id])
  inquilino             inquilino?            @relation(fields: [inquilino_id], references: [id])
  rol                   rol                   @relation(fields: [rol_id], references: [id])
  rol_staff             rol_staff?            @relation(fields: [rol_staff_id], references: [id])
  refresh_tokens        refresh_token[]
  password_reset_tokens password_reset_token[]
  auditoria_login       auditoria_login[]
  subcategorias_responsable subcategoria[]            @relation("subcategoria_responsable")
  supervisor_de             subcategoria_supervisor[]
  solicitudes_creadas       solicitud[]               @relation("solicitud_creador")
  solicitudes_asignadas     solicitud[]               @relation("solicitud_admin_asignado")
  solicitud_historial       solicitud_historial[]
  comentarios               comentario[]

  @@unique([plaza_id, email])
  @@index([rol_id])
  @@index([deleted_at])
  @@map("usuario")
}

/// Rol operativo configurable por plaza (técnico, ingeniero, supervisor, …).
/// Sin catálogo fijo en v1 (S-RolStaff, S-MD-K). Detalles: PLANIFICACION/02 T-019.
model rol_staff {
  id          String   @id @default(uuid()) @db.Uuid
  plaza_id    String   @db.Uuid
  codigo      String
  nombre      String
  descripcion String?
  activo      Boolean  @default(true)
  created_at  DateTime @default(now()) @db.Timestamptz(6)
  updated_at  DateTime @updatedAt @db.Timestamptz(6)

  plaza    plaza     @relation(fields: [plaza_id], references: [id])
  usuarios usuario[]

  @@unique([plaza_id, codigo])
  @@index([plaza_id, activo])
  @@map("rol_staff")
}

/// Refresh token rotado (D3). Se guarda solo el SHA-256, nunca el token plano.
/// Detalles: PLANIFICACION/02 T-020.
model refresh_token {
  id         String    @id @default(uuid()) @db.Uuid
  usuario_id String    @db.Uuid
  token_hash String
  expires_at DateTime  @db.Timestamptz(6)
  revoked_at DateTime? @db.Timestamptz(6)
  user_agent String?
  ip         String?
  created_at DateTime  @default(now()) @db.Timestamptz(6)

  usuario usuario @relation(fields: [usuario_id], references: [id])

  @@index([usuario_id])
  @@map("refresh_token")
}

/// Token de reset de contraseña, un solo uso, 30 min (RN-AU-6).
/// Se guarda solo el SHA-256. Detalles: PLANIFICACION/02 T-020.
model password_reset_token {
  id         String    @id @default(uuid()) @db.Uuid
  usuario_id String    @db.Uuid
  token_hash String
  expires_at DateTime  @db.Timestamptz(6)
  used_at    DateTime? @db.Timestamptz(6)
  created_at DateTime  @default(now()) @db.Timestamptz(6)

  usuario usuario @relation(fields: [usuario_id], references: [id])

  @@index([usuario_id])
  @@map("password_reset_token")
}

/// Bitácora de intentos de login (RN-AU-4, lockout 10/15 min — T-V13).
/// Append-only. plaza_id/usuario_id NULL si el email no existe.
/// Detalles: PLANIFICACION/02 T-021.
model auditoria_login {
  id           String   @id @default(uuid()) @db.Uuid
  plaza_id     String?  @db.Uuid
  usuario_id   String?  @db.Uuid
  email        String
  exitoso      Boolean
  motivo_fallo String?
  ip           String?
  user_agent   String?
  created_at   DateTime @default(now()) @db.Timestamptz(6)

  plaza   plaza?   @relation(fields: [plaza_id], references: [id])
  usuario usuario? @relation(fields: [usuario_id], references: [id])

  @@index([email, created_at])
  @@index([plaza_id, created_at])
  @@map("auditoria_login")
}

/// Auditoría transversal append-only de mutaciones (POST/PATCH/DELETE).
/// Versión MÍNIMA (T-040/T-044): inserción simple. El trigger no-update/delete,
/// el interceptor automático y la retención son T-146/T-150 (módulo 12).
/// `plaza_id`/`usuario_id` son columnas planas (sin FK) porque el log puede
/// sobrevivir a las entidades. `entidad_id` es polimórfico (por entidad_tipo).
/// Detalles: PLANIFICACION/03-plazas-multitenant.md (T-040).
model auditoria {
  id           String   @id @default(uuid()) @db.Uuid
  plaza_id     String?  @db.Uuid
  usuario_id   String?  @db.Uuid
  accion       String
  entidad_tipo String
  entidad_id   String?  @db.Uuid
  antes        Json?
  despues      Json?
  ip           String?
  user_agent   String?
  request_id   String?
  created_at   DateTime @default(now()) @db.Timestamptz(6)

  @@index([plaza_id, created_at])
  @@index([entidad_tipo, entidad_id])
  @@map("auditoria")
}

// ─────────────────────────────────────────────────────────────────────────────
// Locales, inquilinos y contratos (módulo 04 · T-047..T-049)
// ─────────────────────────────────────────────────────────────────────────────

/// Estados de local (S-EstadosLocal, confirmado en T-V07).
enum local_estado {
  disponible
  alquilado
  en_mantenimiento
  fuera_de_servicio
}

/// Estados de contrato (docs/04 §1.1).
enum contrato_estado {
  vigente
  finalizado
  cancelado
}

/// Entidades que admiten adjuntos (docs/04 §4.3.11).
enum adjunto_entidad_tipo {
  solicitud
  local
  contrato
}

/// Local/unidad de la plaza (T-047). Materializa RN-LO-1..RN-LO-6.
/// `estado='alquilado'` solo se setea automáticamente al crear contrato vigente
/// (T-054); `disponible` no se permite si hay contrato vigente (RI-2, app).
model local {
  id          String       @id @default(uuid()) @db.Uuid
  plaza_id    String       @db.Uuid
  codigo      String
  nombre      String?
  metraje_m2  Decimal?     @db.Decimal(10, 2)
  piso        String?
  sector      String?
  descripcion String?
  estado      local_estado @default(disponible)
  created_at  DateTime     @default(now()) @db.Timestamptz(6)
  updated_at  DateTime     @updatedAt @db.Timestamptz(6)
  deleted_at  DateTime?    @db.Timestamptz(6)

  plaza       plaza       @relation(fields: [plaza_id], references: [id])
  contratos   contrato[]
  solicitudes solicitud[]

  @@unique([plaza_id, codigo])
  @@index([plaza_id, estado])
  @@index([deleted_at])
  @@map("local")
}

/// Inquilino (empresa/persona que alquila) (T-048). CU-LO-10..CU-LO-13.
/// UNIQUE parcial (plaza_id, identificacion) WHERE identificacion IS NOT NULL
/// se crea con SQL manual en la migración (Prisma no soporta índices parciales).
model inquilino {
  id                String    @id @default(uuid()) @db.Uuid
  plaza_id          String    @db.Uuid
  razon_social      String
  identificacion    String?
  direccion         String?
  contacto_nombre   String?
  contacto_email    String?
  contacto_telefono String?
  created_at        DateTime  @default(now()) @db.Timestamptz(6)
  updated_at        DateTime  @updatedAt @db.Timestamptz(6)
  deleted_at        DateTime? @db.Timestamptz(6)

  plaza       plaza       @relation(fields: [plaza_id], references: [id])
  contratos   contrato[]
  usuarios    usuario[]
  solicitudes solicitud[]

  @@index([plaza_id])
  @@map("inquilino")
}

/// Contrato de alquiler (T-049). Materializa S-ContratoIndefinido
/// (`fecha_fin` NULL = indefinido) y RN-CO-1..RN-CO-5.
/// CHECK (fecha_fin IS NULL OR fecha_fin >= fecha_inicio) y el trigger
/// anti-solapamiento (T-050) van en SQL manual en las migraciones.
model contrato {
  id                 String          @id @default(uuid()) @db.Uuid
  plaza_id           String          @db.Uuid
  local_id           String          @db.Uuid
  inquilino_id       String          @db.Uuid
  fecha_inicio       DateTime        @db.Date
  fecha_fin          DateTime?       @db.Date
  monto_mensual      Decimal?        @db.Decimal(12, 2)
  moneda             String          @default("USD") @db.Char(3)
  condiciones        String?
  estado             contrato_estado @default(vigente)
  fecha_fin_efectiva DateTime?       @db.Date
  motivo_fin         String?
  created_at         DateTime        @default(now()) @db.Timestamptz(6)
  updated_at         DateTime        @updatedAt @db.Timestamptz(6)

  plaza     plaza     @relation(fields: [plaza_id], references: [id])
  local     local     @relation(fields: [local_id], references: [id])
  inquilino inquilino @relation(fields: [inquilino_id], references: [id])

  @@index([plaza_id, local_id, estado])
  @@index([plaza_id, inquilino_id, estado])
  @@index([fecha_fin])
  @@map("contrato")
}

/// Adjunto polimórfico (T-062, se expande en módulo 08).
/// `entidad_id` es FK lógica según `entidad_tipo` (sin FK física).
model adjunto {
  id               String               @id @default(uuid()) @db.Uuid
  plaza_id         String               @db.Uuid
  entidad_tipo     adjunto_entidad_tipo
  entidad_id       String               @db.Uuid
  nombre_original  String
  mime_type        String
  tamano_bytes     Int
  storage_key      String
  usuario_subio_id String               @db.Uuid
  created_at       DateTime             @default(now()) @db.Timestamptz(6)
  deleted_at       DateTime?            @db.Timestamptz(6)

  plaza plaza @relation(fields: [plaza_id], references: [id])

  @@index([plaza_id, entidad_tipo, entidad_id])
  @@map("adjunto")
}

// ─────────────────────────────────────────────────────────────────────────────
// Categorías y subcategorías (módulo 05 · T-063..T-066)
// ─────────────────────────────────────────────────────────────────────────────

/// Prioridad de solicitud (A más alta … F más baja). Se declara en el módulo 05
/// (⚠️ adelantada de T-078) porque `subcategoria.prioridad` la usa como default
/// heredable (S-FS-Prioridad). Confirmada en T-V04.
enum solicitud_prioridad {
  A
  B
  C
  D
  F
}

/// Categoría de solicitudes, configurable por plaza (T-063, S-Categorias).
/// Soft delete vía `activo=false` (no deleted_at: se conserva para histórico).
model categoria {
  id          String    @id @default(uuid()) @db.Uuid
  plaza_id    String    @db.Uuid
  nombre      String
  descripcion String?
  activo      Boolean   @default(true)
  created_at  DateTime  @default(now()) @db.Timestamptz(6)
  updated_at  DateTime  @updatedAt @db.Timestamptz(6)

  plaza         plaza          @relation(fields: [plaza_id], references: [id])
  subcategorias subcategoria[]
  solicitudes   solicitud[]

  @@unique([plaza_id, nombre])
  @@index([plaza_id, activo])
  @@map("categoria")
}

/// Subcategoría con 1 responsable y 0..5 supervisores (T-064, S-Subcategoria).
/// SC-6: responsable debe ser admin_plaza con rol_staff activo y misma plaza
/// (validado en aplicación, T-071). `prioridad` es la default heredada por
/// las solicitudes al crearse (S-FS-Prioridad).
model subcategoria {
  id             String              @id @default(uuid()) @db.Uuid
  plaza_id       String              @db.Uuid
  categoria_id   String              @db.Uuid
  responsable_id String              @db.Uuid
  nombre         String
  descripcion    String?
  prioridad      solicitud_prioridad @default(B)
  activo         Boolean             @default(true)
  created_at     DateTime            @default(now()) @db.Timestamptz(6)
  updated_at     DateTime            @updatedAt @db.Timestamptz(6)

  plaza        plaza                     @relation(fields: [plaza_id], references: [id])
  categoria    categoria                 @relation(fields: [categoria_id], references: [id])
  responsable  usuario                   @relation("subcategoria_responsable", fields: [responsable_id], references: [id])
  supervisores subcategoria_supervisor[]
  solicitudes  solicitud[]

  @@unique([categoria_id, nombre])
  @@index([plaza_id, activo])
  @@index([responsable_id])
  @@map("subcategoria")
}

/// Pivote N:M subcategoría ↔ supervisores (T-065, S-SC-A). Máx 5 por
/// subcategoría, enforced por trigger tg_subcategoria_max_5_supervisores
/// (T-066, SQL manual). RLS heredado de subcategoria.plaza_id (policy con
/// EXISTS, SQL manual).
model subcategoria_supervisor {
  subcategoria_id String   @db.Uuid
  usuario_id      String   @db.Uuid
  created_at      DateTime @default(now()) @db.Timestamptz(6)

  subcategoria subcategoria @relation(fields: [subcategoria_id], references: [id], onDelete: Cascade)
  usuario      usuario      @relation(fields: [usuario_id], references: [id])

  @@id([subcategoria_id, usuario_id])
  @@index([usuario_id])
  @@map("subcategoria_supervisor")
}

// ─────────────────────────────────────────────────────────────────────────────
// Solicitudes (módulo 06 · T-074..T-078, state machine revisada por T-V03)
// ─────────────────────────────────────────────────────────────────────────────

/// Estados del flujo (T-078). ⚠️ T-V03: incluye `asignado` (entre `enviada` y
/// `en_revision`) y NO existe lock de 30 min. Flujo:
///   borrador → enviada → (cron 15 min) asignado → (tomar) en_revision
///   en_revision → aprobada | rechazada | requerida_subsanacion
///   requerida_subsanacion → enviada (reenvío, vuelve a la cola)
///   * no terminal → cancelada
enum solicitud_estado {
  borrador
  enviada
  asignado
  en_revision
  requerida_subsanacion
  aprobada
  rechazada
  cancelada
}

/// Tipos de solicitud (T-078, S-CamposTipo).
enum solicitud_tipo {
  mantenimiento
  evento
  remodelacion
  otro
}

/// Eventos del historial (T-075). `asignada` es la auto-asignación del cron
/// (T-091b); `tomada` es el admin pasando a revisión (T-091c).
enum solicitud_historial_evento {
  creada
  enviada
  asignada
  tomada
  aprobada
  rechazada
  subsanada
  reasignada
  cancelada
  comentario
  adjunto_agregado
  prioridad_cambiada
}

/// Tipos de comentario (T-077).
enum comentario_tipo {
  decision
  subsanacion
  general
}

/// Solicitud (T-074) — núcleo del negocio. ⚠️ T-V03: sin `lock_expira_at`.
/// `codigo` lo genera el trigger fn_solicitud_set_codigo (SOL-{slug}-{seq},
/// secuencia por plaza); el default '' solo satisface el INSERT de Prisma.
/// `campos_extra` JSONB validado con Zod según `tipo` (T-079).
model solicitud {
  id                 String              @id @default(uuid()) @db.Uuid
  plaza_id           String              @db.Uuid
  local_id           String              @db.Uuid
  inquilino_id       String              @db.Uuid
  usuario_creador_id String              @db.Uuid
  admin_asignado_id  String?             @db.Uuid
  categoria_id       String?             @db.Uuid
  subcategoria_id    String?             @db.Uuid
  codigo             String              @default("")
  tipo               solicitud_tipo
  prioridad          solicitud_prioridad @default(B)
  titulo             String
  descripcion        String
  estado             solicitud_estado    @default(borrador)
  campos_extra       Json                @default("{}")
  fecha_evento_inicio DateTime?          @db.Date
  fecha_evento_fin    DateTime?          @db.Date
  hora_inicio        String?
  hora_fin           String?
  enviada_at         DateTime?           @db.Timestamptz(6)
  asignada_at        DateTime?           @db.Timestamptz(6)
  decision_at        DateTime?           @db.Timestamptz(6)
  created_at         DateTime            @default(now()) @db.Timestamptz(6)
  updated_at         DateTime            @updatedAt @db.Timestamptz(6)

  plaza          plaza         @relation(fields: [plaza_id], references: [id])
  local          local         @relation(fields: [local_id], references: [id])
  inquilino      inquilino     @relation(fields: [inquilino_id], references: [id])
  usuario_creador usuario      @relation("solicitud_creador", fields: [usuario_creador_id], references: [id])
  admin_asignado usuario?      @relation("solicitud_admin_asignado", fields: [admin_asignado_id], references: [id])
  categoria      categoria?    @relation(fields: [categoria_id], references: [id])
  subcategoria   subcategoria? @relation(fields: [subcategoria_id], references: [id])
  historial      solicitud_historial[]
  comentarios    comentario[]

  @@unique([plaza_id, codigo])
  @@index([plaza_id, estado])
  @@index([plaza_id, local_id, created_at])
  @@index([plaza_id, tipo, created_at])
  @@index([plaza_id, fecha_evento_inicio])
  @@index([plaza_id, admin_asignado_id, estado])
  @@index([plaza_id, estado, enviada_at])
  @@map("solicitud")
}

/// Historial append-only del flujo (T-075, RI-1). NO se actualiza ni borra:
/// trigger tg_solicitud_historial_no_update_delete + REVOKE UPDATE/DELETE.
/// `usuario_id` NULL cuando el actor es el sistema (cron de auto-asignación).
model solicitud_historial {
  id              String                     @id @default(uuid()) @db.Uuid
  plaza_id        String                     @db.Uuid
  solicitud_id    String                     @db.Uuid
  usuario_id      String?                    @db.Uuid
  evento          solicitud_historial_evento
  estado_anterior solicitud_estado?
  estado_nuevo    solicitud_estado?
  comentario      String?
  created_at      DateTime                   @default(now()) @db.Timestamptz(6)

  plaza     plaza     @relation(fields: [plaza_id], references: [id])
  solicitud solicitud @relation(fields: [solicitud_id], references: [id])
  usuario   usuario?  @relation(fields: [usuario_id], references: [id])

  @@index([solicitud_id, created_at])
  @@map("solicitud_historial")
}

/// Comentario de solicitud (T-077). `decision`/`subsanacion` solo admin.
model comentario {
  id           String          @id @default(uuid()) @db.Uuid
  plaza_id     String          @db.Uuid
  solicitud_id String          @db.Uuid
  usuario_id   String          @db.Uuid
  tipo         comentario_tipo @default(general)
  cuerpo       String
  created_at   DateTime        @default(now()) @db.Timestamptz(6)

  plaza     plaza     @relation(fields: [plaza_id], references: [id])
  solicitud solicitud @relation(fields: [solicitud_id], references: [id])
  usuario   usuario   @relation(fields: [usuario_id], references: [id])

  @@index([solicitud_id, created_at])
  @@map("comentario")
}

/// Log/cola de emails. Versión MÍNIMA (T-056): registro post-envío para
/// deduplicación de alertas. La cola con reintentos 1m/5m/30m y el worker
/// son T-115..T-118 (módulo 09). `plantilla` discrimina el evento.
model email_log {
  id           String    @id @default(uuid()) @db.Uuid
  plaza_id     String    @db.Uuid
  destinatario String
  plantilla    String
  variables    Json?
  estado       String    @default("pendiente")
  reintentos   Int       @default(0)
  last_error   String?
  sent_at      DateTime? @db.Timestamptz(6)
  created_at   DateTime  @default(now()) @db.Timestamptz(6)

  plaza plaza @relation(fields: [plaza_id], references: [id])

  @@index([plaza_id, plantilla, created_at])
  @@index([estado, reintentos])
  @@map("email_log")
}
