# =============================================================================
# Frontend · Variables de entorno (ejemplo)
# =============================================================================
# Las variables NEXT_PUBLIC_* se exponen al cliente (bundle del navegador).
# El resto son solo server-side.

NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_APP_NAME=Plazapp
AUTH_SECRET=dev-secret-change-me-in-production-min-64-chars-base64-aaaaaaaaaaaaaaaa
NEXTAUTH_URL=http://localhost:3000
TZ=America/El_Salvador
