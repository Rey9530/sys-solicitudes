# =============================================================================
# Plazapp · Variables de PRODUCCIÓN / STAGING (T-159)
# =============================================================================
# Copiar a la RAÍZ del repo como `.env.prod` y completar con secretos REALES.
# NO commitear `.env.prod` (ya está en .gitignore vía *.env / .env*).
#
# Generar secretos:
#   JWT_SECRET / AUTH_SECRET (iguales):  openssl rand -base64 64
#   POSTGRES_PASSWORD / MINIO_* :        openssl rand -base64 24
# =============================================================================

NODE_ENV=production
TZ=America/El_Salvador

# ─────────────────────────────────────────────────────────────────────────────
# Dominio (lo consume Caddy para el TLS y el enrutado)
# Solo el host, sin https:// ni barra final. Ej: app.midominio.com
DOMAIN=app.midominio.com
# Email para los avisos de Let's Encrypt (expiración/errores de certificado).
ACME_EMAIL=tu-correo@midominio.com

# ─────────────────────────────────────────────────────────────────────────────
# PostgreSQL (contenedor interno `postgres`)
POSTGRES_USER=syssol
# ⚠️ Contraseña FUERTE del superusuario. Debe coincidir con DATABASE_ADMIN_URL.
POSTGRES_PASSWORD=CAMBIAR-password-fuerte-postgres
POSTGRES_DB=syssol

# Runtime de la app: rol syssol_app (sin BYPASSRLS, RLS activa).
# ⚠️ La migración enable_rls crea syssol_app con contraseña FIJA 'syssol_app'.
#    No es accesible desde fuera (sin puertos publicados). Para endurecer en el
#    futuro: ALTER ROLE syssol_app PASSWORD '<otra>'; y reflejarlo aquí.
DATABASE_URL=postgresql://syssol_app:syssol_app@postgres:5432/syssol?schema=public

# Conexión ADMIN (superusuario). La usan las migraciones (crean roles/RLS) y el
# admin client (superadmin + auth pre-sesión). Debe usar POSTGRES_PASSWORD.
DATABASE_ADMIN_URL=postgresql://syssol:CAMBIAR-password-fuerte-postgres@postgres:5432/syssol?schema=public
DATABASE_DIRECT_URL=postgresql://syssol:CAMBIAR-password-fuerte-postgres@postgres:5432/syssol?schema=public

# ─────────────────────────────────────────────────────────────────────────────
# Backend (NestJS)
PORT=4000
LOG_LEVEL=info
APP_NAME=Plazapp
APP_BASE_URL=https://app.midominio.com

# CORS y URLs públicas (T-V01: single subdomain). https://<DOMAIN>
CORS_ORIGINS=https://app.midominio.com
FRONTEND_URL=https://app.midominio.com

# ─────────────────────────────────────────────────────────────────────────────
# Auth (T-V13). ⚠️ JWT_SECRET y AUTH_SECRET DEBEN ser IDÉNTICOS (HS256 FE↔BE).
JWT_SECRET=CAMBIAR-openssl-rand-base64-64
JWT_ACCESS_TTL=3600s
JWT_REFRESH_TTL=14d
PASSWORD_RESET_TTL=1800s
LOGIN_LOCKOUT_THRESHOLD=10
LOGIN_LOCKOUT_WINDOW=900s
LOGIN_LOCKOUT_DURATION=900s

# ─────────────────────────────────────────────────────────────────────────────
# MinIO (contenedor interno `minio`)
MINIO_ROOT_USER=plazapp-minio
MINIO_ROOT_PASSWORD=CAMBIAR-password-fuerte-minio
MINIO_BUCKET_PREFIX=plazapp
MINIO_ENDPOINT=minio
MINIO_PORT=9000
MINIO_USE_SSL=false
MINIO_ACCESS_KEY=plazapp-minio
MINIO_SECRET_KEY=CAMBIAR-password-fuerte-minio
MINIO_REGION=us-east-1
MINIO_PRESIGNED_URL_TTL=900s

# ─────────────────────────────────────────────────────────────────────────────
# jsreport (contenedor interno `jsreport`)
JSREPORT_URL=http://jsreport:5488
JSREPORT_USER=admin
JSREPORT_PASSWORD=CAMBIAR-password-jsreport
JSREPORT_AUTH=admin:CAMBIAR-password-jsreport
JSREPORT_COOKIE_SECRET=CAMBIAR-cookie-secret-jsreport

# ─────────────────────────────────────────────────────────────────────────────
# Email · Mailgun API HTTP (staging real)
# Región US: https://api.mailgun.net | EU: https://api.eu.mailgun.net
MAILGUN_API_KEY=key-CAMBIAR
MAILGUN_DOMAIN=mg.midominio.com
MAILGUN_FROM="Plazapp <noreply@mg.midominio.com>"
MAILGUN_API_URL=https://api.mailgun.net

# ─────────────────────────────────────────────────────────────────────────────
# Observabilidad
SENTRY_DSN=
SENTRY_ENVIRONMENT=staging
NEXT_PUBLIC_SENTRY_DSN=

# Rate limit
THROTTLE_GLOBAL_TTL=60000
THROTTLE_GLOBAL_LIMIT=100
THROTTLE_LOGIN_LIMIT=5

# ─────────────────────────────────────────────────────────────────────────────
# Frontend (Next.js)
# NEXT_PUBLIC_API_URL se hornea en BUILD-TIME desde compose (= https://<DOMAIN>).
# Estas dos se leen en runtime (server-side):
NEXT_PUBLIC_APP_NAME=Plazapp
AUTH_SECRET=CAMBIAR-openssl-rand-base64-64
NEXTAUTH_URL=https://app.midominio.com
