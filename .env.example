# =============================================================================
# Plazapp · Variables de entorno (ejemplo, NO copiar con secretos reales)
# =============================================================================
# Aplicar decisiones validadas con el cliente (T-V01..T-V15). Ver
# PLANIFICACION/00-INDICE.md para el detalle de cada decisión.
# =============================================================================

# ─────────────────────────────────────────────────────────────────────────────
# Raíz (compartido por docker-compose y por los workspaces)

# Entorno: development | production
NODE_ENV=development

# Zona horaria fija: El Salvador (T-V08)
TZ=America/El_Salvador

# PostgreSQL (docker-compose usa estos valores)
POSTGRES_USER=syssol
POSTGRES_PASSWORD=syssol
POSTGRES_DB=syssol
# Puerto del host para el contenedor postgres. Cambiar si el 5432 ya está
# ocupado por otro proyecto (recordar reflejarlo en DATABASE_URL).
POSTGRES_PORT=5432

# MinIO
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_BUCKET_PREFIX=plazapp

# =============================================================================
# Backend (NestJS)
# =============================================================================

# Server
PORT=4000
LOG_LEVEL=info
APP_BASE_URL=http://localhost:4000
APP_NAME=Plazapp

# CORS (lista separada por comas). T-V09: app.plazapp.com en prod.
# En producción: CORS_ORIGINS=https://app.plazapp.com
# (T-V01: single subdomain — NO hay wildcard *.plazapp.com)
CORS_ORIGINS=http://localhost:3000

# URL pública del frontend (para construir el link de reset de contraseña).
# T-V01: single domain, la plaza NO aparece en la URL.
FRONTEND_URL=http://localhost:3000

# Database
# Runtime de la app: rol syssol_app SIN BYPASSRLS → RLS activa (T-038, segunda
# capa de defensa multi-tenant). Lo crea la migración enable_rls.
DATABASE_URL=postgresql://syssol_app:syssol_app@localhost:5432/syssol?schema=public
# Conexión admin: superusuario syssol. La usan las migraciones (crean roles y
# políticas RLS) y el "admin client" (superadmin + flujos de auth pre-sesión,
# que bypassan RLS por diseño).
DATABASE_ADMIN_URL=postgresql://syssol:syssol@localhost:5432/syssol?schema=public
DATABASE_DIRECT_URL=postgresql://syssol:syssol@localhost:5432/syssol?schema=public

# Auth (T-V13)
# ⚠️ JWT_SECRET y AUTH_SECRET DEBEN ser iguales (HS256 compartido entre FE y BE)
# Generar con: openssl rand -base64 64
JWT_SECRET=dev-secret-change-me-in-production-min-64-chars-base64-aaaaaaaaaaaaaaaa
JWT_ACCESS_TTL=3600s            # 1 hora (T-V13)
JWT_REFRESH_TTL=14d              # 14 días (T-V13)
PASSWORD_RESET_TTL=1800s         # 30 minutos (T-V13)
LOGIN_LOCKOUT_THRESHOLD=10       # 10 intentos (T-V13)
LOGIN_LOCKOUT_WINDOW=900s        # 15 min (T-V13)
LOGIN_LOCKOUT_DURATION=900s

# MinIO (S3-compatible)
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_USE_SSL=false
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_REGION=us-east-1
MINIO_PRESIGNED_URL_TTL=900s     # 15 min

# jsreport (T-V12: contenedor Docker separado)
JSREPORT_URL=http://localhost:5488
JSREPORT_USER=admin
JSREPORT_PASSWORD=password

# Correo (Mailgun API HTTP). Sin MAILGUN_API_KEY en dev → modo log-only (no
# envía; reemplaza MailHog). En prod/staging requiere API key + dominio.
# MAILGUN_API_URL: US https://api.mailgun.net | EU https://api.eu.mailgun.net
MAILGUN_API_KEY=
MAILGUN_DOMAIN=
MAILGUN_FROM="Plazapp <noreply@plazapp.com>"
MAILGUN_API_URL=https://api.mailgun.net

# jsreport admin auth
JSREPORT_AUTH=admin:password

# Observabilidad (T-V10)
LOG_LEVEL=info
SENTRY_DSN=
SENTRY_ENVIRONMENT=development

# Rate limit (T-149)
THROTTLE_GLOBAL_TTL=60000
THROTTLE_GLOBAL_LIMIT=100
THROTTLE_LOGIN_LIMIT=5

# =============================================================================
# Frontend (Next.js)
# =============================================================================
# Las variables que se exponen al cliente DEBEN empezar con NEXT_PUBLIC_.

# API del backend (Server Components / Server Actions)
NEXT_PUBLIC_API_URL=http://localhost:4000

# Nombre de la app (visible en el header y títulos de página)
NEXT_PUBLIC_APP_NAME=Plazapp

# ⚠️ AUTH_SECRET debe ser IGUAL a JWT_SECRET del backend (HS256, S-ARQ-B)
# Solo se usa server-side para firmar cookies de Auth.js (NextAuth v5).
AUTH_SECRET=dev-secret-change-me-in-production-min-64-chars-base64-aaaaaaaaaaaaaaaa

# URL pública de la app
NEXTAUTH_URL=http://localhost:3000

# Sentry en el cliente (opcional, Sentry init en cliente)
NEXT_PUBLIC_SENTRY_DSN=

# ReCaptcha / Turnstile (opcional, futuro)
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=



/**

  # Estado de los contenedores
  docker compose -f docker-compose.prod.yml --env-file .env.prod ps

  # Las migraciones se aplicaron
  docker compose -f docker-compose.prod.yml --env-file .env.prod logs backend --tail=80 | grep -iE 'migration|started|listening'
  # Las migraciones se aplicaron
  docker compose -f docker-compose.prod.yml --env-file .env.prod logs backend --tail=80 | grep -iE 'migration|started|listening'

  # Y finalmente, el seed inicial (solo esta primera vez)
  docker compose -f docker-compose.prod.yml --env-file .env.prod exec backend npx prisma db seed

  Resumen del flujo completo de primera vez (orden exacto)

  # 1. Levantar y compilar (3-6 min)
  cd /opt/plazapp
  docker compose -f docker-compose.prod.yml --env-file .env.prod up -d --build

  # 2. Confirmar que backend arrancó (las migraciones ya se aplicaron)
  docker compose -f docker-compose.prod.yml --env-file .env.prod logs backend --tail=80 | grep -iE 'migration|started'

  # 3. Seed inicial (crea superadmin, plaza demo, admin/inquilino demo, buckets)
  docker compose -f docker-compose.prod.yml --env-file .env.prod exec backend npx prisma db seed

  # 4. Verificación final
  docker compose -f docker-compose.prod.yml --env-file .env.prod exec postgres \
    psql -U syssol -d syssol -c '\dt' | wc -l
  # Esperado: 70+ tablas

  # 5. Login en el navegador
  # https://app.paseovenecia.com.sv
  # superadmin@plazapp.com / Plazapp2026!

  A partir del segundo deploy (cambios de código, etc.), el comando es el mismo: up -d --build. Compose detecta imágenes sin cambios y las salta, así que tarda segundos.
    */