# =============================================================================
# Plazapp · Variables de PRODUCCIÓN · app.paseovenecia.com.sv
# =============================================================================
# Generar secretos con:
#   openssl rand -base64 64          # JWT_SECRET / AUTH_SECRET (idénticos)
#   openssl rand -base64 24          # passwords de servicios
#
# NO commitear este archivo (ya está en .gitignore vía *.env / .env*).
# =============================================================================

NODE_ENV=production
TZ=America/El_Salvador

# ─────────────────────────────────────────────────────────────────────────────
# Dominio (T-V01: single subdomain, la plaza NO aparece en la URL)
DOMAIN=app.paseovenecia.com.sv
# Email para avisos de Let's Encrypt (expiración / errores de cert)
ACME_EMAIL=tu-correo@paseovenecia.com.sv

# ─────────────────────────────────────────────────────────────────────────────
# PostgreSQL (contenedor interno `postgres`)
POSTGRES_USER=syssol
POSTGRES_PASSWORD=PASEOVE-base64-rand-openssl-32
POSTGRES_DB=syssol

# Runtime app: rol syssol_app SIN BYPASSRLS (RLS activa, segunda capa de defensa)
# ⚠️ La contraseña 'syssol_app' está fijada por la migración enable_rls.
DATABASE_URL=postgresql://syssol_app:syssol_app@postgres:5432/syssol?schema=public
# Conexión ADMIN (superusuario syssol). DEBE usar POSTGRES_PASSWORD.
DATABASE_ADMIN_URL=postgresql://syssol:PASEOVE-base64-rand-openssl-32@postgres:5432/syssol?schema=public
DATABASE_DIRECT_URL=postgresql://syssol:PASEOVE-base64-rand-openssl-32@postgres:5432/syssol?schema=public

# ─────────────────────────────────────────────────────────────────────────────
# Backend (NestJS)
PORT=4000
LOG_LEVEL=info
APP_NAME=Plazapp
APP_BASE_URL=https://app.paseovenecia.com.sv

# CORS y URL pública del frontend (T-V01: single subdomain)
CORS_ORIGINS=https://app.paseovenecia.com.sv
FRONTEND_URL=https://app.paseovenecia.com.sv

# ─────────────────────────────────────────────────────────────────────────────
# Auth (T-V13). ⚠️ JWT_SECRET y AUTH_SECRET DEBEN ser IDÉNTICOS (HS256 FE↔BE).
JWT_SECRET=PASEOVE-openssl-rand-base64-64
JWT_ACCESS_TTL=3600s
JWT_REFRESH_TTL=14d
PASSWORD_RESET_TTL=1800s
LOGIN_LOCKOUT_THRESHOLD=10
LOGIN_LOCKOUT_WINDOW=900s
LOGIN_LOCKOUT_DURATION=900s

# ─────────────────────────────────────────────────────────────────────────────
# MinIO (contenedor interno `minio`)
MINIO_ROOT_USER=plazapp-minio
MINIO_ROOT_PASSWORD=PASEOVE-base64-rand-openssl-32
MINIO_BUCKET_PREFIX=plazapp
MINIO_ENDPOINT=minio
MINIO_PORT=9000
MINIO_USE_SSL=false
MINIO_ACCESS_KEY=plazapp-minio
MINIO_SECRET_KEY=PASEOVE-base64-rand-openssl-32
MINIO_REGION=us-east-1
MINIO_PRESIGNED_URL_TTL=900s

# Host PÚBLICO para URLs pre-firmadas (lo que ve el navegador del usuario).
# El backend firma con MINIO_ENDPOINT interno (minio:9000) pero reescribe
# el host de la URL antes de devolverla para que el cliente apunte al
# subdominio público detrás de NGINX. ⚠️ NGINX DEBE preservar el Host
# header (Host: minio:9000) hacia el upstream o MinIO rechaza la firma
# SigV4. Ver infrastructure/nginx-plazapp-s3.conf.
MINIO_PUBLIC_ENDPOINT=s3.paseovenecia.com.sv
MINIO_PUBLIC_PORT=443
MINIO_PUBLIC_USE_SSL=true
# CORS del propio MinIO (variable de entorno del SERVER).
MINIO_CORS_ALLOW_ORIGIN=https://app.paseovenecia.com.sv

# ─────────────────────────────────────────────────────────────────────────────
# jsreport (contenedor interno `jsreport`)
JSREPORT_URL=http://jsreport:5488
JSREPORT_USER=admin
JSREPORT_PASSWORD=PASEOVE-base64-rand-openssl-32
JSREPORT_AUTH=admin:PASEOVE-base64-rand-openssl-32
JSREPORT_COOKIE_SECRET=PASEOVE-openssl-rand-base64-32

# ─────────────────────────────────────────────────────────────────────────────
# Email · Mailgun API HTTP (producción real)
# Región US: https://api.mailgun.net | EU: https://api.eu.mailgun.net
# (El Salvador cae en US por default)
MAILGUN_API_KEY=key-PASEOVE-de-mailgun
MAILGUN_DOMAIN=mg.paseovenecia.com.sv
MAILGUN_FROM="Plazapp <noreply@mg.paseovenecia.com.sv>"
MAILGUN_API_URL=https://api.mailgun.net

# ─────────────────────────────────────────────────────────────────────────────
# Observabilidad (opcional)
SENTRY_DSN=
SENTRY_ENVIRONMENT=production
NEXT_PUBLIC_SENTRY_DSN=

# Rate limit (T-149)
THROTTLE_GLOBAL_TTL=60000
THROTTLE_GLOBAL_LIMIT=100
THROTTLE_LOGIN_LIMIT=5

# ─────────────────────────────────────────────────────────────────────────────
# Frontend (Next.js)
# NEXT_PUBLIC_API_URL se hornea en BUILD-TIME desde compose (= https://DOMAIN).
# Estas dos se leen en runtime (server-side):
NEXT_PUBLIC_APP_NAME=Plazapp
AUTH_SECRET=PASEOVE-openssl-rand-base64-64-IGUAL-A-JWT_SECRET
NEXTAUTH_URL=https://app.paseovenecia.com.sv